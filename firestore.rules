rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if current user is admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'donatasgricius123@gmail.com' &&
          request.auth.token.email_verified == true) ||
        request.auth.token.get('admin', false) == true
      );
    }

    // Users directory:
    // Private profiles. Admin authority comes from verified identity or server-issued claims.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('role', 'pet_parent') == 'pet_parent');
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']));
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());

      // Play sessions subcollection
      match /sessions/{sessionId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }
    }

    // Custom and managed games catalog:
    // Anyone (even guest players) can read active games
    // Only authenticated admins can create, update, or delete games
    match /custom_games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
